# ============================================
# Production Environment Configuration
# ============================================
# Copy to .env and fill with real values before deploying

APP_NAME="Capital Market Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=Asia/Jakarta

# MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=platform
DB_USER=platform
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_CHARSET=utf8mb4

# PostgreSQL / TimescaleDB
PG_HOST=
PG_PORT=5432
DB_NAME_TS=market_tsdb
PG_USER=postgres
PG_PASS=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
MQ_HOST=
MQ_PORT=5672
MQ_USER=guest
MQ_PASS=guest
MQ_VHOST=/

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_TTL=3600
JWT_REFRESH_TTL=86400
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900

# Application encryption — generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32BYTE_KEY

# S3 / Object Storage
S3_ENDPOINT=
S3_BUCKET=platform-raw-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1

# Logging
LOG_LEVEL=warning
LOG_PATH=storage/logs

# Grafana
GRAFANA_PASSWORD=CHANGE_ME
