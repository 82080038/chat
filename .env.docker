# Docker environment defaults — copied to .env inside container
APP_NAME="Capital Market Platform"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# MySQL (Docker service name: db)
DB_HOST=db
DB_PORT=3306
DB_NAME=platform
DB_USER=platform
DB_PASS=platform_secret
DB_CHARSET=utf8mb4

# Redis (Docker service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT (generate with: php -r "echo base64_encode(random_bytes(32));")
JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=86400
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900

# Application encryption (base64-encoded 32-byte key)
APP_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs
