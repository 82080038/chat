{
  "dashboard": {
    "title": "Capital Market Platform — Overview",
    "tags": ["capital-market"],
    "timezone": "browser",
    "panels": [
      {
        "title": "API Health Status",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "up{job=\"platform-app\"}", "legendFormat": "status" }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
      },
      {
        "title": "Services Registered",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "platform_services_registered", "legendFormat": "services" }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
      },
      {
        "title": "Request Rate (req/s)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{path}}" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
      },
      {
        "title": "Response Time (p95)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
      },
      {
        "title": "Error Rate (5xx)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx errors" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
      },
      {
        "title": "MySQL Connections",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "mysql_threads_connected", "legendFormat": "connected" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
      }
    ],
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "10s"
  }
}
