# Environment
APP_NAME="Capital Market Platform"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=platform
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# PostgreSQL / TimescaleDB
PG_HOST=127.0.0.1
PG_PORT=5432
DB_NAME_TS=market_tsdb
PG_USER=postgres
PG_PASS=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=guest
MQ_PASS=guest
MQ_VHOST=/

# JWT
JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=86400
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900

# Application encryption (base64-encoded 32-byte key)
APP_ENCRYPTION_KEY=

# S3 / Object Storage
S3_ENDPOINT=
S3_BUCKET=platform-raw-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Python Analytics Bridge
PYTHON_ENABLED=false
PYTHON_PATH=python3
PYTHON_SCRIPT_PATH=scripts/analytics_bridge.py
PYTHON_TIMEOUT=30
